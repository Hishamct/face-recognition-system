# ============================================================
# FACE DETECTION & RECOGNITION PLATFORM — ENVIRONMENT CONFIG
# ============================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=facedb
DB_USER=faceapp_user
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Application Settings
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Vision Pipeline Configs
DETECTION_CONFIG_PATH=configs/detection_config.yaml
RECOGNITION_CONFIG_PATH=configs/recognition_config.yaml
FAISS_INDEX_PATH=data/database/faiss_index.bin
GALLERY_METADATA_PATH=data/database/gallery_metadata.json
